# Project root se
cat > .gitignore << 'EOF'
# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Build outputs
dist/
*/dist/
**/dist/
.angular/
*/.angular/

# Environment
.env
*/.env
**/.env
!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
EOF